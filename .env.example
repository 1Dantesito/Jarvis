# ==============================================================================
# JARVIS AI Assistant — Plantilla de Variables de Entorno (.env.example)
# Copia este archivo como '.env' y completa con tus propias credenciales.
# NUNCA compartas ni subas tu archivo '.env' real al repositorio.
# ==============================================================================

# --- Servidor y Entorno ---
HOST=0.0.0.0
PORT=5001
DEV_MODE=false

# --- Proveedores de Inteligencia Artificial (LLM) ---
# Google Gemini (Recomendado como primario / streaming rápido)
GEMINI_API_KEY=your_gemini_api_key_here
DEFAULT_GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_CANDIDATES=gemini-3.5-flash-lite,gemini-3.6-flash

# OpenRouter (Failover multi-modelo)
OPENROUTER_API_KEY=your_openrouter_api_key_here
DEFAULT_OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_MODEL_CANDIDATES=openai/gpt-4o-mini,meta-llama/llama-3.1-8b-instruct,deepseek/deepseek-chat,openrouter/free

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEFAULT_CLAUDE_MODEL=claude-3-5-sonnet-20241022

# --- Servicios Multimedia ---
# YouTube Data API (Opcional, búsqueda de música)
YOUTUBE_API_KEY=your_youtube_api_key_here
# Spotify API (Opcional)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# --- Base de Datos & Sincronización Cloud (Opcional) ---
# Supabase para sincronización remota de memoria a largo plazo
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_service_role_key_here

# --- Contexto Temporal y Ubicación ---
TIMEZONE_OVERRIDE=America/Bogota
ENABLE_LOCATION=true
ALLOW_EXACT_COORDINATES=false

# --- Seguridad y Protocolo de Crisis (Cerebro Relacional) ---
CRISIS_GUARD_TIMEOUT_SECONDS=2.0
CRISIS_GUARD_FAST_MODEL=gemini-2.0-flash-lite

# --- Pipeline de Voz y Escucha Continua (Hands-Free) ---
WAKE_WORD=jarvis
CONVERSATION_WINDOW_SECONDS=12
END_OF_TURN_SILENCE_MS=700
ENABLE_HANDS_FREE=true
